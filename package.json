{
  "name": "pageturner",
  "version": "2.14.0",
  "build": 92,
  "description": "Pageturner — offline-first PWA ebook reader and audiobook player with read-aloud TTS",
  "directories": {
    "doc": "docs"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint docs/js/ docs/sw.js functions/ tests/ scripts/",
    "lint:fix": "eslint docs/js/ docs/sw.js functions/ tests/ scripts/ --fix",
    "icons": "node scripts/generate-icons.js",
    "vendor": "node scripts/build-vendor.js",
    "smoke": "node scripts/smoke.mjs",
    "version": "node scripts/version.js",
    "version:check": "node scripts/version.js --check",
    "version:bump": "node scripts/version.js --bump"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PossiblyPengu/PageTurner.git"
  },
  "keywords": [
    "ebook",
    "epub",
    "audiobook",
    "tts",
    "pwa",
    "reader"
  ],
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/PossiblyPengu/PageTurner/issues"
  },
  "homepage": "https://pageturner.pages.dev",
  "dependencies": {
    "@mintplex-labs/piper-tts-web": "^1.0.5",
    "foliate-js": "^1.0.1",
    "music-metadata-browser": "^2.5.11",
    "node-unrar-js": "^2.0.2",
    "onnxruntime-web": "^1.18.0",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@huggingface/transformers": "3.5.1",
    "@resvg/resvg-js": "^2.6.2",
    "eslint": "^10.0.3",
    "fflate": "^0.8.3",
    "kokoro-js": "1.2.1",
    "puppeteer-core": "^25.12.0",
    "vitest": "^4.1.0"
  }
}
